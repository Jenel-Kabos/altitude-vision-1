{
  "name": "altitude-vision-server",
  "version": "1.1.0",
  "description": "Backend de l'application Altitude-Vision (API REST sécurisée avec Express, JWT et MongoDB).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint . --ext .js,.mjs",
    "format": "prettier --write \"**/*.{js,json,css,md}\"",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns='\\.(mongo|replica)\\.integration\\.test\\.js$'",
    "test:mongo": "node scripts/run-mongo-tests.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:finance:unit": "jest --runInBand --testPathPatterns='financial(?!.*(mongo|replica)\\.).*test\\.js$'",
    "test:finance:mongo": "jest --runInBand --testPathPatterns='financialCore.mongo.integration.test.js'",
    "test:finance:replica": "jest --runInBand --testPathPatterns='financialCore.replica.integration.test.js'",
    "test:finance:resilience": "jest --runInBand --detectOpenHandles --testPathPatterns='financialCore.resilience.replica.integration.test.js'",
    "finance:reconcile": "node scripts/reconcile-finance.js",
    "rental:reconcile": "node scripts/reconcile-rental-management.js",
    "verify": "npm run lint",
    "ci": "npm run lint && npm run test:unit && npm run test:mongo"
  },
  "keywords": [
    "express",
    "mongodb",
    "api",
    "jwt",
    "altitude-vision",
    "backend"
  ],
  "author": "Altitude-Vision Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "cloudinary": "^2.9.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^10.9.0",
    "helmet": "^7.1.0",
    "imapflow": "^1.2.18",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.6",
    "mongodb": "^7.1.1",
    "mongoose": "^8.6.2",
    "mongoose-sequence": "^6.0.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "pdfkit": "^0.19.0",
    "socket.io": "^4.8.3",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^10.2.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
