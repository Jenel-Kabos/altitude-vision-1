{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://altitude-vision.onrender.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://altitude-vision.onrender.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "872164120879-fnllca3lavaintq499hr7rbjjvcrgj3k.apps.googleusercontent.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://altitude-vision-staging.onrender.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://altitude-vision-staging.onrender.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "872164120879-fnllca3lavaintq499hr7rbjjvcrgj3k.apps.googleusercontent.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://altitude-vision.onrender.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://altitude-vision.onrender.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "872164120879-fnllca3lavaintq499hr7rbjjvcrgj3k.apps.googleusercontent.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://altitude-vision.onrender.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://altitude-vision.onrender.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "872164120879-fnllca3lavaintq499hr7rbjjvcrgj3k.apps.googleusercontent.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json"
      }
    }
  }
}
