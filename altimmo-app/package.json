{
  "name": "altimmo-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint App.js index.js src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "check:syntax": "node scripts/check-syntax.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --no-watchman",
    "test:watch": "jest --watch --no-watchman",
    "test:coverage": "jest --coverage --runInBand --no-watchman",
    "doctor": "expo-doctor",
    "validate": "npm run check:syntax && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/vector-icons": "~14.0.4",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@react-navigation/stack": "^6.4.1",
    "@sentry/react-native": "~6.10.0",
    "axios": "^1.7.2",
    "date-fns": "^3.6.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-auth-session": "~6.0.3",
    "expo-av": "~15.0.2",
    "expo-camera": "~16.0.18",
    "expo-crypto": "~14.0.2",
    "expo-dev-client": "~5.0.20",
    "expo-device": "~7.0.3",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image": "~2.0.7",
    "expo-image-picker": "~16.0.6",
    "expo-linear-gradient": "~14.0.2",
    "expo-location": "~18.0.10",
    "expo-notifications": "~0.29.14",
    "expo-secure-store": "~14.0.1",
    "expo-sharing": "~13.0.1",
    "expo-status-bar": "~2.0.1",
    "expo-store-review": "~8.0.1",
    "expo-web-browser": "~14.0.2",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-maps": "1.18.0",
    "react-native-modal": "^13.0.1",
    "react-native-paper": "^5.12.3",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-webview": "13.12.5",
    "socket.io-client": "^4.7.5",
    "supercluster": "^8.0.1"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@miblanchard/react-native-slider",
          "expo-av",
          "socket.io-client",
          "supercluster"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.js"
    ],
    "collectCoverageFrom": [
      "src/config/**/*.{ts,tsx}",
      "src/services/api.js",
      "src/services/socketService.js",
      "src/services/notificationsService.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/src/test/"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^12.4.3",
    "@types/jest": "^29.5.14",
    "babel-preset-expo": "~12.0.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^8.0.1",
    "eslint-plugin-promise": "^7.2.1",
    "jest": "^29.7.0",
    "jest-expo": "^52.0.6",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.3.3"
  }
}
