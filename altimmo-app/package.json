{
  "name": "altimmo-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint App.js index.js src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "check:syntax": "node scripts/check-syntax.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --no-watchman",
    "test:watch": "jest --watch --no-watchman",
    "test:coverage": "jest --coverage --runInBand --no-watchman",
    "doctor": "npx expo-doctor",
    "export": "expo export --platform android",
    "validate": "npm run check:syntax && npm run lint && npm run typecheck && npm run test",
    "verify": "npm run lint && npm run typecheck",
    "ci": "npm run check:syntax && npm run lint && npm run typecheck && npm run test:coverage && npm run doctor && npm run export"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@react-navigation/stack": "^6.4.1",
    "@sentry/react-native": "~7.11.0",
    "axios": "^1.7.2",
    "date-fns": "^3.6.0",
    "expo": "^57.0.10",
    "expo-asset": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-auth-session": "~57.0.6",
    "expo-camera": "~57.0.3",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-picker": "~57.0.7",
    "expo-linear-gradient": "~57.0.1",
    "expo-location": "~57.0.7",
    "expo-notifications": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.1",
    "expo-updates": "~57.0.12",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-modal": "^13.0.1",
    "react-native-paper": "^5.12.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.7.5",
    "supercluster": "^8.0.1"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@miblanchard/react-native-slider",
          "socket.io-client",
          "supercluster"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.js"
    ],
    "collectCoverageFrom": [
      "src/config/**/*.{ts,tsx}",
      "src/services/api.js",
      "src/services/socketService.js",
      "src/services/notificationsService.js",
      "src/services/propertyMapper.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/src/test/"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~57.0.1",
    "eslint-plugin-promise": "^7.2.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
