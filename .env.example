# Backend only. Never expose these values in the mobile bundle.
NODE_ENV=development
PORT=5000
MONGO_URI=
DB_NAME=
JWT_SECRET=
JWT_EXPIRES_IN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY-SANDBOX-PROVISION-1 — used ONLY by server/config/cloudinarySandbox.js
# and future sandbox certification scripts. Never reuse production Cloudinary
# credentials here. cloud_name MUST differ from CLOUDINARY_CLOUD_NAME above, or
# every sandbox tool refuses with CLOUDINARY_SANDBOX_PRODUCTION_COLLISION.
# See server/docs/CLOUDINARY_SANDBOX_PROVISIONING.md for setup instructions.
CLOUDINARY_SANDBOX_CLOUD_NAME=
CLOUDINARY_SANDBOX_API_KEY=
CLOUDINARY_SANDBOX_API_SECRET=
CLOUDINARY_SANDBOX_CONFIRM=
BACKEND_URL=http://localhost:5000
COMPANY_PHONE=
DISABLE_SCHEDULED_JOBS=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
MONGODB_FINANCIAL_INTEGRATION_URI=
FINANCIAL_MONGO_STANDALONE=0
FINANCIAL_RECONCILIATION_ALLOW_PRODUCTION=0
RENTAL_RECONCILIATION_ALLOW_PRODUCTION=0
REAL_ESTATE_RESERVATION_MINUTES=30
RENTAL_CONTRACT_EXPIRY_ALERT_DAYS=30
NEXTAUTH_API_SECRET=
CINETPAY_API_KEY=
CINETPAY_SECRET=
CINETPAY_SITE_ID=
YABETOO_API_URL=
YABETOO_SECRET_KEY=
YABETOO_WEBHOOK_SECRET=
# ALTIMMO-PAY-SAFETY-04A — paiement en ligne des visites : suspendu sauf valeur exacte "true" (parcours non certifié).
# VISIT_PAYMENT_INITIATION_ENABLED=
# ALTIMMO-AI-INTEGRATION-01 — assistant de recherche Altimmo : désactivé sauf valeur exacte "true" (non certifié sur données réelles).
# ALTIMMO_ASSISTANT_ENABLED=
# ALTIMMO-AI-INTEGRATION-01 (DeepSeek) — conseiller conversationnel : désactivé sauf valeur exacte "true".
# Accès : environnement listé ET compte listé (identifiants MongoDB désignés par la Direction ; aucun rôle ne suffit).
# ALTIMMO_ADVISOR_ENABLED=
# ALTIMMO_ADVISOR_ALLOWED_ENVIRONMENTS=development,test
# ALTIMMO_ADVISOR_ALLOWED_USER_IDS=
# ALTIMMO_DEPLOY_ENV=                      # nom d'environnement (défaut : NODE_ENV) ; compteurs de coût séparés par environnement
# ALTIMMO_ADVISOR_LLM_STOP=                # "true" : aucun nouvel appel au fournisseur, réponses du moteur Altimmo seul
# Fournisseur : simulé par défaut ("mock", aucune dépense). DeepSeek uniquement sur choix explicite.
# ALTIMMO_LLM_PROVIDER=mock
# ALTIMMO_LLM_ENABLED=
# ALTIMMO_LLM_MODEL=deepseek-flash
# ALTIMMO_LLM_MONTHLY_BUDGET_USD=10        # plafond applicatif mensuel de l'environnement (marge de sécurité de 10 %)
# ALTIMMO_LLM_SESSION_MAX_USD=0.05
# ALTIMMO_LLM_ACCOUNT_MAX_USD=0.5
# DEEPSEEK_API_KEY=                        # secret serveur uniquement (gestionnaire de secrets de l'hébergeur), jamais dans Git
ZOHO_ACCOUNT_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_WEBHOOK_SECRET=
ZOHO_IMAP_PASSWORD=
ZOHO_FROM=
ZOHO_FROM_EMAIL=
ZOHO_FROM_NAME=
FACEBOOK_ACCESS_TOKEN=
FRONTEND_URL=http://localhost:3000
